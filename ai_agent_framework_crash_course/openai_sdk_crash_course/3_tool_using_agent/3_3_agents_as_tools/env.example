# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI-compatible relay base URL. Keep /v1 if your provider requires it.
OPENAI_BASE_URL=https://your-relay.example.com/v1

# Optional: Organization ID if using OpenAI organization
# OPENAI_ORG_ID=your_organization_id_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_TYPE=chat_completions
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2
OPENAI_TRACING_DISABLED=true
