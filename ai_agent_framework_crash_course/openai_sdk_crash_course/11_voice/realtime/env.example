OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://your-relay.example.com/v1
# Required when using a relay or Azure endpoint for this realtime WebSocket example.
# The provider must explicitly support the OpenAI Realtime WebSocket API.
OPENAI_REALTIME_URL=wss://your-relay.example.com/v1/realtime?model=gpt-realtime-1.5
OPENAI_API_TYPE=chat_completions
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2
OPENAI_TRACING_DISABLED=true
