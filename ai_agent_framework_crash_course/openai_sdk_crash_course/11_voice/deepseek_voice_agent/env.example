# DeepSeek API 密钥 / DeepSeek API key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# DeepSeek OpenAI 兼容接口地址 / DeepSeek OpenAI-compatible base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可用的 DeepSeek 文本模型 / Available DeepSeek text model
DEEPSEEK_MODEL=deepseek-v4-pro

# 本地语音识别模型，可选 tiny、base、small、medium / Local STT model: tiny, base, small, medium
WHISPER_MODEL=base

# 可选：自建 Hugging Face Hub 或企业镜像地址；必须在程序启动前设置 / Optional: private Hub or organization mirror; set before startup
# HF_ENDPOINT=https://your-huggingface-endpoint

# 每次按 Enter 后录音时长（秒）/ Recording duration after pressing Enter (seconds)
RECORD_SECONDS=5
