ENTERPRISE_RAG_COMPANY=Acme Corp
ENTERPRISE_RAG_DB_PATH=backend/data/enterprise_rag.sqlite3
ENTERPRISE_RAG_DEFAULT_KB=general
ENTERPRISE_RAG_CHUNK_SIZE=900
ENTERPRISE_RAG_CHUNK_OVERLAP=120
ENTERPRISE_RAG_TOP_K=5
ENTERPRISE_RAG_RERANK_TOP_K=12
